---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSlider from '../components/HeroSlider.astro';
import VenueCards from '../components/VenueCards.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout
  title="PrivatePartees.com | Chicago Private Event Venues"
  description="Explore three private event venues in Chicago, Franklin Park, and Elmwood Park for weddings, birthdays, quinceañeras, corporate events, and celebrations."
>
  <Header />
  <HeroSlider />
  <VenueCards />

  <section class="section split-section">
    <div class="split-image reveal"><img src="/images/hero/cielo-hero.png" alt="Banquet hall event setup" /></div>
    <div class="split-copy reveal">
      <span class="kicker">Private Events</span>
      <h2>Designed for weddings, birthdays, corporate events, quinceaneras, and unforgettable nights.</h2>
      <p>PrivatePartees.com brings together three distinct venues with elegant rooms, polished service, and photo-ready spaces for every celebration.</p>
      <div class="feature-list">
        <span>Weddings</span><span>Quinceaneras</span><span>Corporate Events</span><span>Birthday Parties</span><span>Baby Showers</span><span>Anniversaries</span>
      </div>
    </div>
  </section>

  <section class="section gallery-preview">
    <div class="section-heading reveal">
      <span>Gallery</span>
      <h2>Picture Your Event Here</h2>
    </div>
    <div class="masonry-grid reveal">
      <img src="/images/hero/cielo-hero.png" alt="Cielo" />
      <img src="/images/hero/avenue-hero.png" alt="The Avenue" />
      <img src="/images/hero/club-elmwood-hero.png" alt="Club Elmwood Park" />
      <img src="/images/hero/cielo-hero2.png" alt="Cielo" />
      <img src="/images/hero/club-elmwood-hero2.png" alt="Club Elmwood Park" />
    </div>
  </section>

  <section class="testimonial reveal">
    <p>“Elegant rooms, beautiful lighting, and a team that knows how to make private events feel special.”</p>
    <span>PrivatePartees.com</span>
  </section>

  <CTA />
  <Footer />

  <!-- Homepage Promotional Popup -->
  <div id="promo-popup" class="promo-overlay" hidden>
  <div
    class="promo-modal"
    role="dialog"
    aria-modal="true"
    aria-label="PrivatePartees venue promotion"
  >
    <button
      class="promo-close"
      type="button"
      aria-label="Close promotion"
    >×</button>

    <img
      src="/images/pp-home-pop.jpg"
      alt="Three private event venues with capacities up to 120 guests"
    />
  </div>
</div>

<style>
  .promo-overlay[hidden] {
    display: none !important;
  }

  .promo-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .promo-modal {
    position: relative;
    max-width: 650px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    justify-content: center;
  }

  .promo-modal img {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 5px;
  }

  .promo-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background: #fff;
    color: #111;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  @media (max-width: 600px) {
    .promo-overlay {
      padding: 15px;
    }

    .promo-modal {
      max-width: 95vw;
    }

    .promo-close {
      top: -12px;
      right: -8px;
    }
  }
</style>

<script>
  const popup = document.getElementById('promo-popup');
  const closeButton = popup?.querySelector('.promo-close');
  const storageKey = 'privatepartees-promo-seen';

  function closePromo() {
    if (!popup) return;
    popup.hidden = true;
    sessionStorage.setItem(storageKey, '1');
    document.removeEventListener('keydown', handleEscape);
  }

  function handleEscape(event) {
    if (event.key === 'Escape') closePromo();
  }

  if (popup && !sessionStorage.getItem(storageKey)) {
    popup.hidden = false;
    closeButton?.focus();
    document.addEventListener('keydown', handleEscape);

    closeButton?.addEventListener('click', closePromo);

    popup.addEventListener('click', (event) => {
      if (event.target === popup) closePromo();
    });
  }
</script>
</BaseLayout>

