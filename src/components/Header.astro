---
const nav = [
  ['/', 'Home'],
  ['/#venues', 'Venues'],
  ['/about/', 'About'],
  ['/contact/', 'Contact']
];
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="PrivatePartees Home">
    <img src="/images/logos/parteeslogo.png" alt="PrivatePartees.com" />
  </a>
  <button class="menu-toggle" data-menu-toggle aria-label="Open menu">Menu</button>
  <nav class="main-nav" data-menu>
    {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    <a class="nav-cta" href="/contact/">Inquire</a>
  </nav>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-D305FXB1KR"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-D305FXB1KR');
</script>

</header>
