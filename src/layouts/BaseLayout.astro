---
import '../styles/global.css';
const {
  title = 'PrivatePartees.com | Private Event Venues',
  description = 'Private event venues in Chicago, Franklin Park, and Elmwood Park for weddings, birthdays, quinceañeras, corporate events, and private celebrations.',
  image = '/images/share/privatepartees-og.jpg'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://privatepartees.com');
const imageURL = new URL(image, 'https://privatepartees.com');
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PrivatePartees.com" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="stylesheet" href="/src/styles/global.css" />
  <script is:inline src="/js/site.js"></script>
</head>
  <body>
    <slot />
   <script is:inline src="/js/site.js"></script>
  </body>
</html>
